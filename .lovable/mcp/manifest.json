{
  "version": 1,
  "sdk_version": "3.1.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zsyrthmisdcvpvblbubk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "food-truck-qc",
      "version": "0.1.0",
      "title": "Food Truck QC"
    },
    "tools": [
      {
        "name": "search_trucks",
        "title": "Search food trucks",
        "description": "Find approved Quad Cities food trucks by smart location, cuisine, published dishes and Central-time schedules including recurring stops.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 100
            },
            "location": {
              "type": "string",
              "maxLength": 200
            },
            "city": {
              "type": "string",
              "maxLength": 80
            },
            "cuisine": {
              "type": "string",
              "maxLength": 60
            },
            "dish": {
              "type": "string",
              "maxLength": 80
            },
            "menu_item": {
              "type": "string",
              "maxLength": 80
            },
            "near": {
              "type": "string",
              "maxLength": 200
            },
            "address": {
              "type": "string",
              "maxLength": 200
            },
            "truck_id": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9_-]+$"
            },
            "when": {
              "type": "string"
            },
            "open_now": {
              "type": "boolean"
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "radius_miles": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 14
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "upcoming_stops",
