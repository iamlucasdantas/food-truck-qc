      {
        "name": "add_my_stop",
        "title": "Add a stop to my schedule",
        "description": "Add where the signed-in owner's truck will be: a dated stop (date, start, end in Central time, venue and/or street address) or a weekly repeating stop. Shows on the public map and the truck page. Ask for the address if the owner only gave a venue name you can't place.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "truck_id": {
              "description": "From my_truck; optional when the owner has one truck.",
              "type": "string",
              "maxLength": 150
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "YYYY-MM-DD, Central time. For a weekly stop: the first date."
            },
            "start": {
              "type": "string",
              "pattern": "^\\d{1,2}:\\d{2}$",
              "description": "HH:MM 24h Central, e.g. 11:00."
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{1,2}:\\d{2}$",
              "description": "HH:MM 24h Central, e.g. 14:00 (an end before the start means past midnight)."
            },
            "address": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "Street address with city, e.g. \"2500 53rd St, Moline, IL\"."
            },
            "venue_name": {
              "description": "Place name shown to customers, e.g. \"Marketplace at 2500\"; defaults to the address.",
              "type": "string",
              "maxLength": 150
            },
            "note": {
              "description": "Short public note, e.g. \"Cash only today\".",
              "type": "string",
              "maxLength": 500
            },
            "repeat_weekly": {
              "default": false,
              "description": "true = every week on the same weekday(s) until cancelled.",
              "type": "boolean"
            },
            "weekdays": {
              "description": "With repeat_weekly: 0=Sun … 6=Sat; defaults to the weekday of date.",
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "until": {
              "description": "With repeat_weekly: last date (YYYY-MM-DD), optional.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "date",
            "start",
            "end",
            "address"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "check_in",
        "title": "I'm here (go live)",
        "description": "Mark the signed-in owner's truck as open right now at a place — the same as the big “I'm here” button. Give a street address (or lat/lng); with no location the truck's home base is used. Lasts 2 hours by default, 15 min to 12 h, or until a Central time. Replaces any earlier live check-in.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "truck_id": {
              "description": "From my_truck; optional when the owner has one truck.",
              "type": "string",
              "maxLength": 150
            },
            "address": {
              "description": "Where the truck is parked, e.g. \"1601 River Dr, Moline, IL\".",
              "type": "string",
              "minLength": 3,
              "maxLength": 300
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "venue_name": {
              "description": "Label customers see, e.g. \"Bass Street Landing\"; defaults to \"Live location\".",
              "type": "string",
              "maxLength": 150
            },
            "minutes": {
              "description": "How long you'll be there (default 120).",
              "type": "integer",
              "minimum": 15,
              "maximum": 720
            },
            "until": {
              "description": "Or an end time HH:MM Central.",
              "type": "string",
              "pattern": "^\\d{1,2}:\\d{2}$"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
