            },
            "near": {
              "type": "string",
              "maxLength": 200
            },
            "address": {
              "type": "string",
              "maxLength": 200
            },
            "truck_id": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9_-]+$"
            },
            "when": {
              "type": "string"
            },
            "open_now": {
              "type": "boolean"
            },
