      {
        "name": "my_favorites",
        "title": "My favorite trucks",
        "description": "List the signed-in user's favorite (hearted) food trucks.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "set_favorite",
        "title": "Heart or unheart a truck",
        "description": "Add a truck to, or remove it from, the signed-in user's favorites.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "truck_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Truck id from search_trucks."
            },
            "favorite": {
              "type": "boolean",
              "description": "true to add, false to remove."
            }
          },
          "required": [
            "truck_id",
            "favorite"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_list_businesses",
        "title": "Admin: list businesses",
        "description": "Admin only. List businesses (optionally filtered by name) with the trucks each one owns.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Part of the business name.",
              "type": "string",
              "maxLength": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_save_business",
        "title": "Admin: create or edit a business",
        "description": "Admin only. Create or update the business of an owner account (one business per owner, identified by owner_id or owner_email). Only sent fields change.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "owner_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "owner_email": {
              "description": "Account email of the owner (must already have signed up).",
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "website": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "instagram": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "facebook": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "payment_methods": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_delete_business",
        "title": "Admin: delete a business",
        "description": "Admin only. Delete an owner's business record. Their trucks are kept (use admin_delete_truck for those).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "owner_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "owner_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_get_truck",
        "title": "Admin: get a truck",
        "description": "Admin only. Find trucks by id or name (any status) with their business owner.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 150
            },
            "name": {
              "type": "string",
              "maxLength": 150
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_save_truck",
        "title": "Admin: create or edit a truck",
        "description": "Admin only. Without id creates a truck; with id updates only the sent fields. owner_id links the truck to a business (its owner account). base_address is geocoded to a map pin. Fixed trucks need an address to be active.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "description": "Truck id to edit; omit to create.",
              "type": "string",
              "maxLength": 150
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "category": {
              "type": "string",
              "maxLength": 60
            },
            "truck_type": {
              "type": "string",
              "enum": [
                "mobile",
                "fixed",
                "hybrid"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "pending",
                "archived"
              ]
            },
            "description": {
              "type": "string",
              "maxLength": 3000
            },
            "menu_summary": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1500
                },
                {
                  "type": "null"
                }
              ]
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "website": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "instagram": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "facebook": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_address": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_food_truck": {
              "type": "boolean"
            },
            "owner_id": {
              "description": "Business owner account id; null unlinks.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_delete_truck",
        "title": "Admin: delete a truck",
        "description": "Admin only. Deletes a truck (logged; restorable from Admin for 30 days, then purged with its stops).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_list_stops",
        "title": "Admin: list a truck's stops",
        "description": "Admin only. Dated stops of one truck from a date (default today, Central time).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "truck_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "YYYY-MM-DD (Central time)."
            }
          },
          "required": [
            "truck_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_save_stop",
        "title": "Admin: create or edit a stop",
        "description": "Admin only. Without id adds a dated stop to a truck; with id edits it (send date+start+end together to move it). The address is geocoded to a map pin.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "description": "Stop id to edit; omit to create.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "truck_id": {
              "description": "Required to create.",
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "venue_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "address": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "YYYY-MM-DD (Central time)."
            },
            "start": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "HH:MM 24h, Central time."
            },
            "end": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "HH:MM 24h, Central time."
            },
            "note": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "cancelled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_delete_stop",
        "title": "Admin: delete a stop",
        "description": "Admin only. Permanently delete one dated stop.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
