      {
        "name": "register_my_truck",
        "title": "Put my truck on the map",
        "description": "Register the signed-in owner's food truck on FoodTruckQC: creates their business profile if needed and submits the truck for approval (it appears on the public map once the FoodTruckQC team approves it, usually within a day). Ask the owner for anything you don't know instead of guessing: truck name, kind of food, mobile or fixed, home city or address, phone.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "truck_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "description": "Name painted on the truck, e.g. \"Taco One\"."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Kind of food, e.g. Tacos, BBQ, Pizza, Coffee."
            },
            "truck_type": {
              "default": "mobile",
              "description": "mobile = moves between stops; fixed = always at one address; hybrid = both.",
              "type": "string",
              "enum": [
                "mobile",
                "fixed",
                "hybrid"
              ]
            },
            "base_address": {
              "type": "string",
              "minLength": 2,
              "maxLength": 300,
              "description": "Home base: a street address, or just the city, e.g. \"Davenport, IA\". Fixed trucks need the full address."
            },
            "business_name": {
              "description": "Business/LLC name if different from the truck; defaults to the truck name or the existing business.",
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "phone": {
              "description": "Public phone customers can call.",
              "type": "string",
              "maxLength": 40
            },
            "description": {
              "description": "One or two sentences for the public page.",
              "type": "string",
              "maxLength": 1500
            },
            "website": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "instagram": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "facebook": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "owner_name": {
              "description": "Owner's name for the FoodTruckQC team (not public).",
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [
            "truck_name",
            "category",
            "base_address"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
